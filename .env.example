DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=True

POSTGRES_DB=signalevent
POSTGRES_USER=signalevent
POSTGRES_PASSWORD=signalevent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://localhost:6379/2

PUBLIC_SUBMISSION_REQUEST_IP_LIMIT=15
PUBLIC_SUBMISSION_REQUEST_IP_WINDOW_SECONDS=300
PUBLIC_SUBMISSION_SOURCE_LIMIT=5
PUBLIC_SUBMISSION_SOURCE_WINDOW_SECONDS=600
PUBLIC_SUBMISSION_SOURCE_COOLDOWN_SECONDS=30
PUBLIC_SUBMISSION_DUPLICATE_WINDOW_SECONDS=600
